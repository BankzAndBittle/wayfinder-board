{
  "name": "wayfinder-board",
  "version": "0.1.0",
  "description": "Render a Wayfinder map as a board.",
  "type": "module",
  "bin": {
    "wayfinder-board": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts --format esm --target node20 --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src test scripts",
    "shots": "tsx scripts/shots.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "playwright": "^1.64.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
